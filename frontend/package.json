{
  "name": "gomp-frontend",
  "private": true,
  "version": "3.15.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "codegen": "openapi-typescript ../openapi.yaml -o ./src/helpers/schema.gen.ts --root-types --root-types-no-schema-prefix --enum",
    "test": "vitest run",
    "test:watch": "vitest",
    "cover": "vitest run --coverage"
  },
  "dependencies": {
    "@ionic/core": "^9.0.0",
    "dompurify": "^3.2.6",
    "ionicons": "^8.1.0",
    "lit": "^3.2.1",
    "openapi-fetch": "^0.17.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.2",
    "vitest-fetch-mock": "^0.4.5"
  }
}
