{
  "editor.formatOnSave": true,
  "editor.renderWhitespace": "boundary",
  "go.coverOnSave": true,
  "go.coverageDecorator": {
    "type": "gutter",
  },
  "go.coverageOptions": "showUncoveredCodeOnly",
  "go.inlayHints.assignVariableTypes": true,
  "go.inlayHints.functionTypeParameters": true,
  "go.inlayHints.parameterNames": true,
  "go.inlayHints.rangeVariableTypes": true,
  "go.lintTool": "revive",
  "go.lintFlags": [
    "-config=${workspaceRoot}/revive.toml"
  ],
  "oxc.configPath": "static/.oxlintrc.json",
  "oxc.path.tsgolint": "static/node_modules/oxlint-tsgolint/bin/tsgolint.js",
  "sonarlint.connectedMode.project": {
    "connectionId": "chadweimer",
    "projectKey": "chadweimer_gomp"
  },
  "testing.defaultGutterClickAction": "runWithCoverage",
  "yaml.format.singleQuote": true,
}
