{
  "name": "gomp",
  "private": true,
  "description": "GOMP: Go Meal Planner - A web-based recipe book",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "clear": "rm -fr ./node_modules",
    "clean": "rm -fr ./dist && rm -f src/helpers/schema.gen.ts",
    "preview": "vite preview",
    "codegen": "openapi-typescript ../openapi.yaml -o ./src/helpers/schema.gen.ts --root-types --root-types-no-schema-prefix --enum",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cover": "vitest run --coverage"
  },
  "dependencies": {
    "@ionic/core": "^9.0.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-invisible-characters": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.2.6",
    "ionicons": "^8.1.0",
    "lit": "^3.2.1",
    "openapi-fetch": "^0.17.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-fetch-mock": "^0.4.5"
  }
}
